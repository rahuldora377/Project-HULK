{
  "manifest_version": 3,
  "name": "Project HULK",
  "version": "2.2.0",
  "description": "Recon toolkit: payloads, JS files, relative paths and Google domain extraction.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "clipboardWrite",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "http://www.google.com/*",
    "https://google.com/*",
    "http://google.com/*"
  ],
  "background": {
    "scripts": [
      "google/domain-utils.js",
      "google/config.js",
      "google/logger.js",
      "google/scraper.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Project HULK — Recon Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hulk-recon@projecthulk.dev",
      "strict_min_version": "115.0"
    }
  }
}
